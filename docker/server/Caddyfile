{
  debug
  admin :2019
}

:443 {
  tls /secrets/server.crt /secrets/server.key {
    client_auth {
      mode require_and_verify
	  trust_pool file {
	    pem_file "/secrets/ca.crt" "/secrets/intermediate-2026.crt"
	  }
    }
  }

  request_header -X-Client-Common-Name

  @common_name vars_regexp common_name {http.request.tls.client.subject} (?:^|,\s*)CN=([^,]+)

  handle @common_name {
    reverse_proxy {
      to echo:8080
      header_up X-Client-Common-Name {re.common_name.1}
    }
  }
}
